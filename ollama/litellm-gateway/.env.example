# Server
APP_HOST=0.0.0.0
APP_PORT=4000
LOG_LEVEL=INFO
LITELLM_CONFIG_PATH=/app/litellm_config.yaml
REQUEST_TIMEOUT_SEC=180

# Routing
ENABLE_LLM_ROUTER=true
ENABLE_RULE_ROUTER=true
ROUTER_CLASSIFIER_MAX_TOKENS=8
ROUTER_CLASSIFIER_TEMPERATURE=0
CLASSIFIER_MODEL=openai/qwen3-routing-classifier
CLASSIFIER_API_BASE=http://thor:8002/v1
CLASSIFIER_API_KEY=sk-local

# Full local JSONL audit log. Contains prompts and model responses.
LLM_AUDIT_LOG=true
LLM_AUDIT_LOG_PATH=/app/logs/llm-requests.jsonl
LLM_AUDIT_LOG_MAX_CHARS=100000
LLM_AUDIT_LOG_MAX_BYTES=52428800

# Upstream model endpoints
GENERAL_MODEL=openai/qwen3.6
GENERAL_API_BASE=http://thor:8000/v1
GENERAL_API_KEY=sk-local

CODER_MODEL=openai/qwen2.5-coder
CODER_API_BASE=http://thor:8001/v1
CODER_API_KEY=sk-local

# Optional comma-separated override list.
# If empty, keyword_list from litellm_config.yaml is used.
ROUTER_KEYWORDS=

# Network-visible name returned in /v1/models
EXPOSED_GENERAL_NAME=general
EXPOSED_CODER_NAME=coder
EXPOSED_CLASSIFIER_NAME=classify
